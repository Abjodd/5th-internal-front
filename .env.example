# Base URL of the backend API (see /backend). Defaults to
# http://localhost:4000 in src/lib/api.js if this is not set.
VITE_API_URL=http://localhost:4000

# Base URL of the public client-facing site / brand portal. Used by the
# founder's "open client login" shortcut (src/pages/Auth) and by the Summary
# footer links. Defaults to https://www.fifth-avenue.in if this is not set.
VITE_CLIENT_PORTAL_URL=http://localhost:5174
